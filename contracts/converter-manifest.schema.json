{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibridge.local/schemas/converter-manifest.schema.json",
  "title": "ConverterManifest",
  "description": "转换器清单：每个标准转换器的声明文件（manifest.json）。仅官方签发：signature 校验通过方可启用。",
  "type": "object",
  "required": ["id", "name", "version", "level", "readable_paths", "entry", "signature"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "转换器标识，通常与目标 app 一致，如 qq"
    },
    "name": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "level": {
      "enum": ["c", "b", "a"],
      "description": "接入等级：c=会话注入，b=凭据填表，a=仅启动"
    },
    "readable_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "可读路径声明：沙盒只开放这些路径的只读访问，超出即拒绝"
    },
    "entry": {
      "type": "string",
      "description": "转换器入口（WASM 模块文件名），沙盒内执行：无网络、只读声明路径、只输出 StandardAccess"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signer": { "type": "string", "description": "签名者标识（官方发布密钥 ID）" },
        "value": { "type": "string", "description": "签名值（hex）" }
      }
    },
    "min_app_version": {
      "type": "string",
      "description": "可选：要求的最低主程序版本"
    }
  }
}
