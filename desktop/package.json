{
  "name": "ab-desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-Bridge Windows 桌面端 UI（Vue 3 + TypeScript + Vite，运行在 Tauri 2 的 WebView 内，薄入口）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "check:structure": "node scripts/check-structure.mjs",
    "check:render": "node scripts/render-check.mjs",
    "check": "npm run check:structure && npm run check:render"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.1.10"
  }
}
