# === 工具缓存（过程产物，不入库）===
__pycache__/
*.pyc
.npm-cache/
.firecrawl/
.research/
research/
node_modules/

# === 构建期缓存（集中放置，项目收尾统一清理）===
.cargo-home/
tools/.self-test-tmp/
.dsh-inspect/

# === Tauri 生成物 ===
# gen/schemas 的 4 个 json 已入库（Tauri 生成的 schema 快照，commit 9a1b095 有意收录），
# 只忽略 schemas 之外的后续生成物
desktop/src-tauri/gen/*
!desktop/src-tauri/gen/schemas/
desktop/src-tauri/gen/schemas/*
!desktop/src-tauri/gen/schemas/*.json

# === 开发过程文档（设计稿，非最终产物，不入库）===
docs/

# === Rust ===
target/
**/*.rs.bk

# === 构建产物 ===
dist/
build/
out/
web-ext-artifacts/
*.log

# === 移动端 ===
mobile/ffi/generated/
.gradle/
local.properties
Pods/
DerivedData/
*.xcuserstate
*.ipa
*.apk

# === 系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 敏感文件（本项目处理密钥，任何密钥/加密库文件绝不入库）===
.env
.env.*
*.pem
*.key
*.p12
*.kdbx
*.aibvault
.acl-recovery/
