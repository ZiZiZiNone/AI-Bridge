// AI-Bridge · UniFFI 接口声明（事实源：mobile/ffi/aibridge.udl，构建副本：core/ffi/src/aibridge.udl）

namespace aibridge {
    AibridgeCore new_core(
        CoreConfig config,
        VaultStore vault_store,
        SessionSource session_source,
        Transport transport,
        Clock clock,
        Entropy entropy
    );
};

/* ======================= core 公开面（对象） ======================= */

interface AibridgeCore {
    Vault vault();
    StateBus state();
    Broker broker();
    SyncEngine sync();
    ConverterHost converter_host();
    AuditLog audit();
};

interface Vault {
    [Throws=CoreError] void unlock(string master_password);
    void lock();
    boolean is_locked();
    [Throws=CoreError] sequence<EntrySummary> list_entries(string? query);
    [Throws=CoreError] Entry get_entry(string account_ref);
    [Throws=CoreError] void put_entry(Entry entry);
    [Throws=CoreError] void delete_entry(string account_ref);
    sequence<EntrySummary> trash();
    [Throws=CoreError] void restore(string account_ref);
    [Throws=CoreError] GeneratedSecret generate(GeneratorSpec spec);
    [Throws=CoreError] string totp(string account_ref);
};

interface StateBus {
    sequence<MatrixRow> matrix();
    [Throws=CoreError] SessionEnvelope capture(string source_id, string domain);
    sequence<SnapshotSummary> snapshot();
    [Throws=CoreError] void rollback(string snapshot_id);
    HealthReport health();
};

interface Broker {
    [Throws=CoreError] IssuedSession issue(ScopeSpec scope, u32 ttl_seconds);
    [Throws=CoreError] IssuedSession renew(string session_id, u32 ttl_seconds);
    [Throws=CoreError] void release(string session_id);
    [Throws=CoreError] void revoke(string session_id);
    sequence<IssuedSession> revoke_all();
    sequence<IssuedSession> list_sessions();
    sequence<IssuedSession> sweep();
};

interface SyncEngine {
    [Throws=CoreError] PairingTicket pair();
    [Throws=CoreError] PairingTicket confirm(string ticket_id, string remote_fingerprint);
    [Throws=CoreError] TransferReport transfer(string peer_id, sequence<SessionEnvelope> envelopes);
    [Throws=CoreError] bytes pack(sequence<SessionEnvelope> envelopes);
    [Throws=CoreError] sequence<SessionEnvelope> unpack(bytes package);
};

interface ConverterHost {
    [Throws=CoreError] void load(ConverterManifest manifest);
    [Throws=CoreError] ManifestVerification verify(ConverterManifest manifest);
    [Throws=CoreError] StandardAccess run_extract(string converter_id, string level);
};

interface AuditLog {
    [Throws=CoreError] void record_or_fail(AuditEvent event);
    sequence<AuditEvent> query(AuditFilter filter);
};

interface McpServer {
    [Throws=CoreError] void serve();
    sequence<McpTool> tools();
};

/* ======================= 宿主必须实现的 traits ======================= */

[Trait]
interface VaultStore {
    [Throws=CoreError] bytes read(string key);
    [Throws=CoreError] void write(string key, bytes value);
    [Throws=CoreError] void remove(string key);
    [Throws=CoreError] sequence<string> list_keys();
};

[Trait]
interface SessionSource {
    sequence<string> available_sources();
    sequence<Cookie> capture(string source_id, string domain);
    void inject(string source_id, sequence<Cookie> cookies);
};

[Trait]
interface Transport {
    sequence<PeerInfo> peers();
    [Throws=CoreError] void send(string peer_id, bytes payload);
    bytes? receive(u32 timeout_millis);
};

[Trait]
interface Clock {
    i64 now_unix_secs();
};

[Trait]
interface Entropy {
    bytes fill(u32 length);
};

/* ======================= 契约层镜像（contracts/*.schema.json） ======================= */

dictionary CoreConfig {
    string data_dir;
    string display_name;
};

dictionary Cookie {
    string name;
    string value;
    string? domain;
    string? path;
    boolean? secure;
    boolean? http_only;
    SameSite? same_site;
    string? expires_at;
};

dictionary Target {
    TargetKind kind;
    string? domain;
    string? app_id;
};

dictionary PlainCredential {
    string username;
    string secret;
};

dictionary Payload {
    sequence<Cookie> cookies;
    string? token;
    PlainCredential? credential;
    record<string, string> local_storage;
};

dictionary Source {
    SourceType source_type;
    string id;
};

dictionary CredentialRecord {
    string account_ref;
    CredentialKind kind;
    string? username;
    string? secret;
    string? totp_seed;
    string? url;
};

dictionary SessionRecord {
    string account_ref;
    Target target;
    SessionKind kind;
    Payload payload;
    string? expires_at;
    Source source;
    ClientEnv? client_env;
};

dictionary SessionEnvelope {
    string schema_version;
    string account_ref;
    Target target;
    SessionKind kind;
    Payload payload;
    string issued_at;
    string? expires_at;
    Source source;
    ScopeSpec? scope;
    ClientEnv? client_env;
};

dictionary StandardAccess {
    string schema_version;
    string app_id;
    AccessLevel level;
    string generated_at;
    sequence<CredentialRecord> credentials;
    sequence<SessionRecord> sessions;
    record<string, string> meta;
    ClientEnv? client_env;
};

dictionary Signature {
    string algorithm;
    string signer;
    string value;
};

dictionary ConverterManifest {
    string id;
    string name;
    string version;
    AccessLevel level;
    sequence<string> readable_paths;
    string entry;
    string module_sha256;
    Signature signature;
    string? min_app_version;
};

/* ======================= core 内部数据结构 ======================= */

dictionary EntrySummary {
    string account_ref;
    string title;
    CredentialKind kind;
    string? username;
    string? url;
    string? updated_at;
};

dictionary Entry {
    string account_ref;
    string title;
    CredentialKind kind;
    string? username;
    string? secret;
    string? totp_seed;
    string? url;
    string? note;
};

dictionary GeneratorSpec {
    u32 length;
    boolean lowercase;
    boolean uppercase;
    boolean digits;
    boolean symbols;
};

dictionary GeneratedSecret {
    string value;
    string charset;
};

dictionary MatrixRow {
    string account_ref;
    TargetKind target_kind;
    string? domain;
    string? app_id;
    SourceType source_type;
    string? expires_at;
    string? last_seen_at;
};

dictionary SnapshotSummary {
    string snapshot_id;
    string created_at;
    u32 entry_count;
};

dictionary HealthReport {
    boolean vault_readable;
    boolean sync_reachable;
    sequence<string> warnings;
};

dictionary ScopeSpec {
    sequence<string> domain_allowlist;
    boolean read_only;
    boolean single_use;
};

dictionary ClientEnv {
    string user_agent;
    string platform;
    string? device_id;
};

dictionary IssuedSession {
    string session_id;
    string account_ref;
    string expires_at;
    boolean revoked;
};

dictionary PairingTicket {
    string ticket_id;
    string fingerprint;
    string? remote_fingerprint;
};

dictionary TransferReport {
    u32 sent;
    u32 failed;
};

dictionary ManifestVerification {
    boolean valid;
    string? reason;
};

dictionary AuditEvent {
    string who;
    string when;
    string? account_ref;
    string? domain;
    AuditAction action;
    AuditResult result;
    record<string, string> detail;
};

dictionary AuditFilter {
    string? who;
    string? account_ref;
    string? domain;
    AuditAction? action;
    AuditResult? result;
};

dictionary PeerInfo {
    string peer_id;
    string device_kind;
    string fingerprint;
};

dictionary McpTool {
    string name;
    string description;
};

/* ======================= 枚举 ======================= */

enum AccessLevel { "C", "B", "A" };
enum CredentialKind { "PASSWORD", "PASSKEY", "TOTP" };
enum SessionKind { "COOKIE", "TOKEN", "CREDENTIAL" };
enum TargetKind { "WEB", "APP", "CONTAINER" };
enum SameSite { "STRICT", "LAX", "NONE" };
enum SourceType { "EXTENSION", "CONVERTER", "MOBILE", "MANUAL", "SYNC" };
enum AuditAction { "UNLOCK", "LOCK", "CAPTURE", "INJECT", "FILL", "ISSUE", "RELEASE", "REVOKE", "REVOKE_ALL", "SWEEP", "EXTRACT", "CONVERTER_LOAD", "CONVERTER_REJECT", "PAIR", "SYNC", "VAULT_WRITE", "VAULT_DELETE", "RESTORE", "EXPORT" };
enum AuditResult { "OK", "DENIED", "FAILED" };

/* ======================= 错误 ======================= */

[Error]
enum CoreError {
    "CONTRACT",
    "CRYPTO",
    "STORAGE",
    "NOT_FOUND",
    "DENIED",
    "TRANSPORT",
    "CONVERSION",
    "INTERNAL",
};

[Error]
enum ContractError {
    UnsupportedSchemaVersion(string version),
    InvalidId(string field, string value),
    EmptyField(string name),
    TargetFieldMissing(string name),
    PayloadMismatch(SessionKind kind, string expected),
    UnsupportedAlgorithm(string algorithm),
    MissingExpiry,
    MissingScope,
    PlaceholderSignature,
    InvalidModuleHash,
};
